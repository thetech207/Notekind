{
  "manifest_version": 3,
  "name": "Notekind",
  "version": "0.1.0",
  "description": "Local-first knowledge journal — daily notes, wikilinks, and web clipping into plain Markdown files.",
  "minimum_chrome_version": "114",
  "background": {
    "service_worker": "src/sw.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "src/app/index.html"
  },
  "permissions": ["storage", "contextMenus", "downloads", "scripting", "activeTab"],
  "action": {
    "default_title": "Notekind"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
